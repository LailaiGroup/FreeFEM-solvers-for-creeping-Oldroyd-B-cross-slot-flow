verbosity=0;
load "PETSc-complex"
load "iovtk"
include "getARGV.idp"
macro dimension()2//
include "macro_ddm.idp"
real s0=clock();

int NrRequestedEv = getARGV("-nev",4); // number of requested eigenvalues
real We = getARGV("-Wi",0.4);
real beta = 1.0/9.0;
real kDCS = 5e-5; //polymer diffusion
real cs=getARGV("-supg",0.3); //SUPG
real sqrt2=sqrt(2.);

if (mpirank == 0) {
    string mkeigDir = "mkdir -p eig/eigMod_Wi"+ We;
    int execDir = exec(mkeigDir);
}

complex sigma = getARGV("-shift_real", 0.) + getARGV("-shift_imag", 0.) * 1i;

macro TauDCS(t11,t12,t12,t22) 1.0 //
macro epsilon(u,v) [dx(u),dy(v),(dy(u)+dx(v))/sqrt2] //
macro Divergence(ux, uy) (dx(ux) + dy(uy)) //
macro divTensor(G11,G12,G21,G22) [dx(G11)+dy(G21), dx(G12)+dy(G22)] //
macro tensorDotP(A11, A12, A21, A22, B11, B12, B21, B22)  [A11*B11 + A12*B21, A11*B12+
A12*B22, A21*B11 + A22*B21, A21*B12+A22*B22] //
macro vecDotGradTensor(u1, u2, t11, t12 ,t21, t22) [u1*dx(t11)+u2*dy(t11), u1*dx(t12)+u2*dy(t12),u1*dx(t21)+u2*dy(t21),u1*dx(t22)+u2*dy(t22)]//

load "gmsh"
mesh ThG = gmshload("../../mesh/M2.msh");
func Pk = [P2,P2,P1, P1,P1,P1,P1, P1,P1,P1];
fespace Gh(ThG, Pk);
Gh [u1b,u2b,pb, G11b,G12b,G21b,G22b, t11b,t12b,t22b];
Gh [u1w,u2w,pw, G11w,G12w,G21w,G22w, t11w,t12w,t22w];
Gh [u1p,u2p,pp, G11p,G12p,G21p,G22p, t11p,t12p,t22p];
string rdin = "output_base/reconstr_Wi" + We + ".sol";
ifstream fu1(rdin);
fu1>>u1b[];




{
mesh Th = ThG;
fespace Mh(Th, P1);
fespace Xh(Th, P2);
fespace XXMh(Th, Pk);

XXMh<complex> [u1,u2,p, G11,G12,G21,G22, t11,t12,t22];
XXMh<complex> [v1,v2,q, w11,w12,w21,w22, s11,s12,s22];

XXMh [u1a,u2a,pa, G11a,G12a,G21a,G22a, t11a,t12a,t22a];

//SUPG
Mh h = hTriangle;
cout << "size of mesh = " << h[].max << endl;
macro S(s11) s11+cs*h/sqrt(u1b^2+u2b^2)*(u1b*dx(s11)+u2b*dy(s11)) //

varf vfStokes ([u1,u2,p, G11,G12,G21,G22, t11,t12,t22],[v1,v2,q, w11,w12,w21,w22, s11,s12,s22]) =
int2d(Th)(1/We*( (1-beta)*(
        	                [S(s11), S(s12), S(s12), S(s22)]'*[G11,G12,G21,G22]
            	            + [S(s11), S(s12), S(s12), S(s22)]'*[G11,G21,G12,G22]
                	    )
                    -[S(s11),S(s12),S(s12),S(s22)]'*[t11,t12,t12,t22]
                    //DCS
                    -kDCS*TauDCS(t11,t12,t12,t22)*(
					 dx(s11)*dx(t11)+2*dx(s12)*dx(t12)+dx(s22)*dx(t22)
					+dy(s11)*dy(t11)+2*dy(s12)*dy(t12)+dy(s22)*dy(t22)
                    )
            )

	    -(
    	     [S(s11), S(s12), S(s12), S(s22)]'*vecDotGradTensor(u1b, u2b, t11, t12,t12, t22)
            +[S(s11), S(s12), S(s12), S(s22)]'*vecDotGradTensor(u1, u2, t11b, t12b,t12b, t22b)
            -[S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(t11b,t12b,t12b,t22b, G11,G12,G21,G22)
            -[S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(t11,t12,t12,t22, G11b,G12b,G21b,G22b)
            -[S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(G11b,G21b,G12b,G22b, t11,t12,t12,t22)
            -[S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(G11,G21,G12,G22, t11b,t12b,t12b,t22b)
        )
            - p * Divergence(v1, v2)
            + 2.*epsilon(u1,u2)'*epsilon(v1,v2)
			- [v1,v2]'*divTensor(t11,t12,t12,t22)
	        + (1-beta)*(
    	           divTensor(G11,G12,G21,G22)'*[v1,v2]
       		      + divTensor(G11,G21,G12,G22)'*[v1,v2]
            	)
		    - q * Divergence(u1, u2)
            - 1e-10*p*q
            + [w11, w12, w21, w22]'*[G11,G12,G21,G22]
    	    - [w11, w12, w21, w22]'*[dx(u1),dx(u2),dy(u1),dy(u2)]

)

+on(23,24,26, 66,68,69,
	67,73,78, 65,71,75,
	62,63,64, 17,19,21,
	2, 7, 12, 5, 10,16, u1=0,u2=0) //wall
+on(1,3,  u1=0, u2=0, t11=0,t12=0,t22=0) //inletL
+on(79,80,u1=0, u2=0, t11=0,t12=0,t22=0) //inletR
+on(28,50,18,39,u1=0, p=0); //outlet

varf b([u1,u2,p, G11,G12,G21,G22, t11,t12,t22],[v1,v2,q, w11,w12,w21,w22, s11,s12,s22]) = int2d(Th)([S(s11),S(s12),S(s12),S(s22)]'*[t11,t12,t12,t22]);

int[int] myN2O;
macro ThN2O() myN2O//

Mat<complex> OP,B;
macro def(i)[i, i#B, i#C, i#D, i#E, i#F, i#G, i#H, i#I, i#J]//
macro init(i)[i, i, i, i, i, i, i, i, i, i]//
createMat(Th,OP,Pk)
createMat(Th,B,Pk)
OP=vfStokes(XXMh,XXMh);
B=b(XXMh,XXMh);
int[int] rest = restrict(XXMh, Gh, myN2O);

complex[int] Evalues(NrRequestedEv);
XXMh<complex>[int] def(vec)(NrRequestedEv);

// parameters for the distributed eigenvalue solver
string para = "-eps_tol 1.0e-6 -eps_nev " + NrRequestedEv + " " +
    " -eps_largest_real " +
    "-eps_type krylovschur -st_type sinvert -eps_monitor_all " +
    "-eps_target " + real(sigma) + "+" + imag(sigma) + "i"
    ;
if (mpirank == 0) {
    cout<<"calc eigenvalue"<<endl;
}
int k = EPSSolve(OP,B, vectors=vec, values=Evalues, sparams = para) ;
k=min(k,NrRequestedEv);
string wt =  "eig/eig_Wi"+We+".txt";
ofstream eigva(wt,append);
string tab = "eig/sigma.txt";
ofstream ofsigma(tab,append);
for (int i=0;i<k;i++)
{
    if (mpirank == 0) {
        cout << " eigenvalue = " << i << "  : " << Evalues[i] << endl;
        eigva << " eigenvalue = " << i << "  : " << Evalues[i]<< endl;
        ofsigma << We << "," << Evalues[i] <<endl;
    }

    [u1a,u2a,pa, G11a,G12a,G21a,G22a, t11a,t12a,t22a] = [real(vec[i]), real(vecB[i]), real(vecC[i]), real(vecD[i]), real(vecE[i]), real(vecF[i]), real(vecG[i]), real(vecH[i]), real(vecI[i]), real(vecJ[i])];



    u1a[] .*= OP.D; 
    u1p[](rest)=u1a[];
    mpiAllReduce(u1p[], u1w[], mpiCommWorld, mpiSUM);
    if(mpirank==0)
        plot(ThG);

    if(mpirank==0){
    string t11name = "eig/eigMod_Wi"+ We+"/" + "vec_" + i + ".txt";
	ofstream t11f(t11name);
    t11f << u1w[];

    int[int] Orderu = [1, 1,1, 1,1,1];
    string DataNameu = "eigen_";
	DataNameu = DataNameu +  i;
    string fu = "eig/eigMod_Wi"+ We+"/" + DataNameu + ".vtu";
    savevtk(fu, ThG, pw,[u1w,u2w],[t11w,t12w,t22w], dataname="p u taup",order=Orderu);
    //use paraview to open .vtu file rather than .pvd file, or may have warnings

    string rmpvd = "rm eig/eigMod_Wi"+ We + "/*.pvd" + "  eig/eigMod_Wi"+ We + "/*.pvtu";
    int execDir = exec(rmpvd);
    }
}

} //prll

cout << "CPU " << clock()-s0 << "s " << endl;
