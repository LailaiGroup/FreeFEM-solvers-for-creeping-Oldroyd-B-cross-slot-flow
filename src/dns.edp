verbosity=0;
string mkeigDir = "mkdir -p data | mkdir -p output";
exec(mkeigDir);
load "PETSc"                        // PETSc plugin
macro dimension()2// EOM            // 2D or 3D
include "macro_ddm.idp"             // additional DDM functions
include "getARGV.idp"


real t=0;
real dt=getARGV("-dt",1e-3);
real tEnd=getARGV("-tEnd",400.0);   // physical end time
int M=int(tEnd/dt+0.5);             // number of time steps
int outputInterval=500;
int printInterval=100;

real We = getARGV("-Wi",0.4);
real beta = 1.0/9.0;

real kDCS = 5e-5; //polymer diffusion
real cs=0.3; //SUPG
real sqrt2=sqrt(2.);

load "gmsh"
mesh Th = gmshload("../../mesh/M2.msh");

macro div(u1, u2)  (dx(u1) + dy(u2))//
macro epsilon(u,v) [dx(u),dy(v),(dy(u)+dx(v))/sqrt2] //

macro Divergence(ux, uy) (dx(ux) + dy(uy)) //

macro divTensor(G11,G12,G21,G22) [dx(G11)+dy(G21), dx(G12)+dy(G22)] //
macro tensorDotP(A11, A12, A21, A22, B11, B12, B21, B22)  [A11*B11 + A12*B21, A11*B12+
A12*B22, A21*B11 + A22*B21, A21*B12+A22*B22] //

mesh backupTh =Th;
int[int] myN2O;
macro ThN2O() myN2O//
buildDmesh(Th) //Th is local!

//  FE Space
fespace Mh(Th, P1);
func Pk = [P2,P2,P1, P1,P1,P1,P1];
fespace Wh(Th, Pk);  
Wh [u1, u2, p, G11, G12, G21, G22];
Wh [v1, v2, q, w11, w12, w21, w22];

func Ps = [P1,P1,P1];             
fespace Qh(Th, Ps);
Qh [t11, t12, t22]=[0,0,0];
Qh [t11old, t12old, t22old];
Qh [t11r, t12r, t22r];
Qh [s11, s12, s22];

macro TauDCS(t11,t12,t12,t22) 1.0 //


//SUPG
Mh h = hTriangle;
cout << "size of mesh = " << h[].max << endl;
macro S(s11) (s11+cs*h/sqrt(u1^2+u2^2+1e-12)*(u1*dx(s11)+u2*dy(s11))) //

varf vStokes([u1, u2, p, G11, G12, G21, G22], [v1, v2, q, w11, w12, w21, w22])
		  = int2d(Th)(		 
	         2.*epsilon(u1,u2)'*epsilon(v1,v2)
			 - p * Divergence(v1, v2)
			 - 1e-10*p*q
	         + (1-beta)*(
    	           divTensor(G11,G12,G21,G22)'*[v1,v2]
       		      + divTensor(G11,G21,G12,G22)'*[v1,v2]
            	)
		     - q * Divergence(u1, u2) 
	         + [w11, w12, w21, w22]'*[G11,G12,G21,G22]
    	     - [w11, w12, w21, w22]'*[dx(u1),dx(u2),dy(u1),dy(u2)]
		    )	
			+ on(1,3,u1=1.5-6*y*y,u2=0)//ineltL
			+ on(79,80,u1=6*y*y-1.5,u2=0)//inletR
			+ on(23,24,26, 66,68,69,
				 67,73,78, 65,71,75,
				 62,63,64, 17,19,21,
				 2, 7, 12, 5, 10,16, u1=0,u2=0) //wall
			+ on(28,50,18,39, p=0,u1=0); //outlet  

varf vbcStokes([u1, u2, p, G11, G12, G21, G22], [v1, v2, q, w11, w12, w21, w22])
		= 	int2d(Th)(
				[v1,v2]'*divTensor(t11old,t12old,t12old,t22old)
			)
			+ on(1,3,u1=1.5-6*y*y,u2=0)//ineltL
			+ on(79,80,u1=6*y*y-1.5,u2=0)//inletR
			+ on(23,24,26, 66,68,69,
				 67,73,78, 65,71,75,
				 62,63,64, 17,19,21,
				 2, 7, 12, 5, 10,16, u1=0,u2=0) //wall
			+ on(28,50,18,39, p=0,u1=0); //outlet  

varf vOB([t11, t12, t22],[s11, s12, s22])
		  = int2d(Th)(
    	       [S(s11),S(s12),S(s12),S(s22)]'*[t11,t12,t12,t22]
			   + We/dt*(
					S(s11)*t11+S(s12)*t12+S(s12)*t12+S(s22)*t22
			   )
			
			   - We*(
					 ([S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(t11,t12,t12,t22,G11,G12,G21,G22))
	              	+ ([S(s11), S(s12), S(s12), S(s22)]'*tensorDotP(G11,G21,G12,G22,t11,t12,t12,t22))
			    )
            )
			+ int2d(Th)(kDCS*
				TauDCS(t11,t12,t12,t22)*(
					 dx(s11)*dx(t11)+2*dx(s12)*dx(t12)+dx(s22)*dx(t22)
					+dy(s11)*dy(t11)+2*dy(s12)*dy(t12)+dy(s22)*dy(t22)
				)
			)

			+on(1,3,  t11=288*We*y*y*(1-beta),t12=-(1-beta)*12*y,t22=0) //inletL
			+on(79,80,t11=288*We*y*y*(1-beta),t12= (1-beta)*12*y,t22=0); //inletR

varf vbcOB([t11, t12, t22],[s11, s12, s22])	
			=-int2d(Th)(
				-We*(
    	        	convect (  [u1, u2], -dt, t11old )*S(s11)
					+2*convect (  [u1, u2], -dt, t12old )*S(s12)
					+convect (  [u1, u2], -dt, t22old )*S(s22)
			  	)/dt	
				+ (beta-1)*(
        	      [S(s11), S(s12), S(s12), S(s22)]'*[G11,G12,G21,G22]
            	+ [S(s11), S(s12), S(s12), S(s22)]'*[G11,G21,G12,G22]
				)
			)
			+on(1,3,  t11=288*We*y*y*(1-beta),t12=-(1-beta)*12*y,t22=0) //inletL
			+on(79,80,t11=288*We*y*y*(1-beta),t12= (1-beta)*12*y,t22=0); //inletR

Mat A;
{
macro def(i)[i, i#B, i#C, i#D, i#E, i#F, i#G]//
macro init(i)[i, i, i, i, i, i, i]//
createMat(Th,A,Pk)
set(A, sparams = "-pc_type lu");
A = vStokes(Wh, Wh);
}

Mat B;
{
macro def(i)[i, i#B, i#C]//
macro init(i)[i, i, i]//
createMat(Th,B,Ps)
set(B, sparams = "-pc_type lu");
}


fespace WhGlobal(backupTh,Pk);
int[int] subIdx = restrict(Wh,WhGlobal, myN2O);
WhGlobal [u1w, u2w, pw, G11w, G12w, G21w, G22w];
WhGlobal [u1g, u2g, pg, G11g, G12g, G21g, G22g];

fespace QhGlobal(backupTh,Ps);
int[int] subIdxq = restrict(Qh,QhGlobal, myN2O);
QhGlobal [t11w,t12w,t22w],[t11g,t12g,t22g];
//QhGlobal [t11w,t12w,t22w],[t11g,t12g,t22g],[t11rt,t12rt,t22rt]; // uncomment together with the restart snippet below

real[int] xProbe=[0.0];
real[int] yProbe=[1.0];
real[int] probe(6);
int preci=12;

// restart from a saved t11 field instead of the zero initial condition 
// ifstream fu1("data0/t11_83.6.txt"); //new variable t11rt for restart to avoid bugs
// fu1>>t11rt[];
// for[i, v : subIdxq] t11[][i] = t11rt[][v]; // going from global to local

if (mpirank==0){
         cout << "In simulation, Wi = " << We <<endl;
         cout << "dt = " << dt << ", tEnd = " << tEnd << ", M = " << M << " steps" << endl;
}

for(int m = 0; m < M; m++){
	if (mpirank==0 && m%printInterval==0){
		cout << " t = " << t << endl;	
	}	
	[t11old, t12old, t22old] = [t11, t12, t22];
	
	real[int] bStokes = vbcStokes(0, Wh);	
	u1[]=A^-1*bStokes;

	B = vOB(Qh, Qh);
	real[int] bOB = vbcOB(0, Qh);	
	t11[]=B^-1*bOB;

	if(m%outputInterval==0)
	{	
		u1[].*=A.D;
		u1g[](subIdx)=u1[];
		mpiAllReduce(u1g[],u1w[],mpiCommWorld,mpiSUM);

			[t11r, t12r, t22r] = [t11, t12, t22];
			t11r[].*=B.D;
			t11g[](subIdxq)=t11r[];
			mpiAllReduce(t11g[],t11w[],mpiCommWorld,mpiSUM);


			if(mpirank==0){
				int[int] Orderu = [1, 1,1, 1,1,1];
				string DataNameu = "p_u_G_tau_";
				DataNameu = DataNameu +  t;
				string fu = "output/" + DataNameu + ".vtu";
				savevtk(fu, backupTh, pw, [u1w, u2w], [t11w, t12w, t22w], dataname="p u tau",order=Orderu);

				string t11name =  "data/t11_"+t+".txt";
				ofstream t11f(t11name); t11f << t11w[];

				string u1name =  "data/u1_"+t+".txt";
				ofstream u1f(u1name); u1f << u1w[];

	    		probe[0]=u1w(xProbe[0],yProbe[0]);
	    		probe[1]=u2w(xProbe[0],yProbe[0]);
	   			probe[2]= pw(xProbe[0],yProbe[0]);
	    		probe[3]=t11w(xProbe[0],yProbe[0]);
	    		probe[4]=t12w(xProbe[0],yProbe[0]);
	    		probe[5]=t22w(xProbe[0],yProbe[0]);
				string probeName =  "probe_Wi"+We+".txt";
				ofstream ofprobe(probeName,append);
				ofprobe.precision(preci);
				ofprobe << t << ", "<<probe[0] << ", "<<probe[1]<< ", "<<probe[2]<< ", "<<probe[3]<< ", "<<probe[4]<<", "<<probe[5]<<endl;
			}
	}
    t += dt;
}
cout << " CPU "<< clock()<< " s " << endl;
